# ============================================================
# DEMIS Schema Semantic Search PoC - Production Environment
# Copy to .env.production and fill in real values.
# Do NOT commit .env.production or real secrets.
# ============================================================

# Public hostname served by Traefik (required)
APP_HOST=schema.example.com

# External Traefik Docker network (must already exist; deploy.sh will not create it)
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINTS=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
# Optional: comma-separated Traefik middleware names. Leave unset/commented —
# an empty middlewares= label breaks Traefik. Add the label in a compose
# fragment only when this value is non-empty.
# TRAEFIK_MIDDLEWARES=secHeaders@file

# --- schema_catalog ---
CATALOG_DB_NAME=schema_catalog
CATALOG_DB_USER=catalog_user
CATALOG_DB_PASSWORD=change_me_catalog_password

# --- medical_demo (only when using --profile demo) ---
MEDICAL_DB_NAME=medical_demo
MEDICAL_DB_USER=medical_user
MEDICAL_DB_PASSWORD=change_me_medical_password
SEED_PATIENT_COUNT=200
SEED_RANDOM_SEED=42

# --- Backend / embedding ---
LOG_LEVEL=INFO
# medical-db uses compose profile "demo"; production health must not require it
MEDICAL_DB_REQUIRED=false
# Local model:
# EMBEDDING_PROVIDER=bge_m3
# EMBEDDING_MODEL_PATH=/models/local/bge-m3
#
# Shared OpenAI-compatible API (ALZI):
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_API_URL=https://alzi-embedding.openlink.kr
EMBEDDING_API_KEY=
EMBEDDING_API_TIMEOUT_SECONDS=60
EMBEDDING_MODEL_NAME=BAAI/bge-m3
# EMBEDDING_MODEL_PATH=/models/local/bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=8
EMBEDDING_MAX_SEQ_LENGTH=1024
EMBEDDING_NORMALIZE=true
# EMBEDDING_MODEL_REVISION=<hf-commit-sha-or-tag>
# HF_HUB_OFFLINE=true

# --- Evaluation reproducibility metadata (optional) ---
# EVALUATION_GIT_COMMIT=<git-sha>
# EVALUATION_MODEL_REVISION=<hf-commit-sha-or-tag>

# --- Search ---
ALLOW_FAKE_SEMANTIC_SEARCH=false

# --- Target DB connect timeout ---
TARGET_DB_CONNECT_TIMEOUT_SECONDS=5
# Register external Targets with hostname/IP only (no protocol/path).

# --- Target credential encryption (Fernet) ---
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Never commit a real production key. Set the real value only in .env.production.
TARGET_CREDENTIAL_ENCRYPTION_KEY=replace_with_fernet_key

SEARCH_RRF_K=60
SEARCH_CANDIDATE_MULTIPLIER=3
SEARCH_CANDIDATE_MIN=20

# Frontend → backend (compose DNS; not published externally)
BACKEND_URL=http://backend:8000
