# DEMIS Schema Analyzer - GPU server internal-LAN deployment
# Copy to .env.lan and edit values. Do not commit .env.lan.
#
# Find the GPU server LAN IPv4 with:
#   ip -4 addr show
# or:
#   hostname -I
#
# Example only:
LAN_BIND_IP=192.168.0.100

# Only frontend is exposed on LAN.
FRONTEND_EXTERNAL_PORT=8501

# Backend and PostgreSQL ports are host-loopback diagnostics only.
BACKEND_EXTERNAL_PORT=8000
MEDICAL_DB_EXTERNAL_PORT=5433
CATALOG_DB_EXTERNAL_PORT=5434

MEDICAL_DB_NAME=medical_demo
MEDICAL_DB_USER=medical_user
MEDICAL_DB_PASSWORD=change_me_local_medical

CATALOG_DB_NAME=schema_catalog
CATALOG_DB_USER=catalog_user
CATALOG_DB_PASSWORD=change_me_local_catalog

# LAN test defaults: no shared external embedding endpoint required.
# Change only when semantic/hybrid evaluation is intentionally required.
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
ALLOW_FAKE_SEMANTIC_SEARCH=false

LOG_LEVEL=INFO
TARGET_DB_CONNECT_TIMEOUT_SECONDS=5

# Generate a real Fernet key before saving Target DB passwords.
# Example:
# docker compose --env-file .env.lan -f docker-compose.yml -f docker-compose.lan.yml run --rm backend \
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TARGET_CREDENTIAL_ENCRYPTION_KEY=replace_with_fernet_key

# Oracle Free mock fixture
ORACLE_TEST_ENABLED=true
ORACLE_TEST_IMAGE=container-registry.oracle.com/database/free:latest-lite
ORACLE_TEST_SYS_PASSWORD=OracleDevAdmin123
DEMIS_ORACLE_OWNER_PASSWORD=DemisOwnerDev123
DEMIS_ORACLE_RO_PASSWORD=DemisRoDev123
