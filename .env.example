# ============================================================
# DEMIS Schema Semantic Search PoC - Environment Variables
# Copy this file to .env and adjust values as needed.
# Do NOT commit .env to version control.
# ============================================================

# --- medical_demo (Mock Medical DB) ---
MEDICAL_DB_HOST=medical-db
MEDICAL_DB_PORT=5432
MEDICAL_DB_NAME=medical_demo
MEDICAL_DB_USER=medical_user
MEDICAL_DB_PASSWORD=medical_pass_change_me
MEDICAL_DB_EXTERNAL_PORT=5433

# --- schema_catalog (Catalog / future pgvector) ---
CATALOG_DB_HOST=catalog-db
CATALOG_DB_PORT=5432
CATALOG_DB_NAME=schema_catalog
CATALOG_DB_USER=catalog_user
CATALOG_DB_PASSWORD=catalog_pass_change_me
CATALOG_DB_EXTERNAL_PORT=5434

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_EXTERNAL_PORT=8000
LOG_LEVEL=INFO

# --- Frontend ---
FRONTEND_EXTERNAL_PORT=8501
BACKEND_URL=http://backend:8000

# --- Seed ---
SEED_PATIENT_COUNT=200
SEED_RANDOM_SEED=42

# --- Embedding (Step 3, CPU-only) ---
# fake: deterministic vectors for tests/CI (no model download)
# bge_m3: local BAAI/bge-m3 via sentence-transformers (CPU) — historic baseline / comparison
# openai_compatible: shared OpenAI-compatible HTTP API (e.g. ALZI BGE-M3) — optional comparison
# koe5: local/offline nlpai-lab/KoE5 (recommended for closed-network / military deploy)
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL_NAME=BAAI/bge-m3
# Offline / air-gapped local weights:
# EMBEDDING_MODEL_PATH=/models/local/bge-m3
# Shared remote API (dev comparison only; not required for closed-network deploy):
# EMBEDDING_PROVIDER=openai_compatible
# EMBEDDING_API_URL=https://alzi-embedding.openlink.kr
# EMBEDDING_API_KEY=
# EMBEDDING_API_TIMEOUT_SECONDS=60
#
# Closed-network / offline KoE5 (recommended production candidate):
# EMBEDDING_PROVIDER=koe5
# EMBEDDING_MODEL_NAME=nlpai-lab/KoE5
# EMBEDDING_MODEL_PATH=/models/koe5
# EMBEDDING_MODEL_REVISION=bc6d284c60fe5a973e74c1751b92594c9f581213
# EMBEDDING_DIMENSION=1024
# EMBEDDING_MAX_SEQ_LENGTH=512
# EMBEDDING_NORMALIZE=true
# HF_HUB_OFFLINE=true
# Prepare weights: python backend/scripts/prepare_koe5_model.py --output models/koe5
EMBEDDING_DEVICE=cpu
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=8
EMBEDDING_MAX_SEQ_LENGTH=1024
EMBEDDING_NORMALIZE=true
# EMBEDDING_NUM_THREADS=4
# HF_HUB_OFFLINE=true
# Pin HF revision for reproducibility (also recorded in evaluation run_metadata)
# EMBEDDING_MODEL_REVISION=<hf-commit-sha-or-tag>

# --- Evaluation reproducibility (Step 5.1) ---
# Docker/CI often lacks .git; inject commit explicitly for run_metadata.git_commit
# EVALUATION_GIT_COMMIT=<git-sha>
# Optional metadata-only revision override (prefer EMBEDDING_MODEL_REVISION when loading)
# EVALUATION_MODEL_REVISION=<hf-commit-sha-or-tag>

# --- Search (Step 4) ---
# Fake provider blocks semantic/hybrid unless explicitly allowed (tests only)
ALLOW_FAKE_SEMANTIC_SEARCH=false

# --- Target DB connect timeout (Test Connection / Inspect) ---
# Driver-level connect timeout in seconds (default 5).
TARGET_DB_CONNECT_TIMEOUT_SECONDS=5
# Host must be hostname/IP only (no http:// or URL path).

# --- Target credential encryption (Fernet) ---
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Never commit a real production key.
TARGET_CREDENTIAL_ENCRYPTION_KEY=replace_with_fernet_key

SEARCH_RRF_K=60
SEARCH_CANDIDATE_MULTIPLIER=3
SEARCH_CANDIDATE_MIN=20
# MEDICAL_TERMS_PATH=/app/app/resources/medical_terms.json
