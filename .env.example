# ============================================================
# DEMIS Schema Semantic Search PoC - Environment Variables
# Copy this file to .env and adjust values as needed.
# Do NOT commit .env to version control.
# ============================================================

# --- medical_demo (Mock Medical DB) ---
MEDICAL_DB_HOST=medical-db
MEDICAL_DB_PORT=5432
MEDICAL_DB_NAME=medical_demo
MEDICAL_DB_USER=medical_user
MEDICAL_DB_PASSWORD=medical_pass_change_me
MEDICAL_DB_EXTERNAL_PORT=5433

# --- schema_catalog (Catalog / future pgvector) ---
CATALOG_DB_HOST=catalog-db
CATALOG_DB_PORT=5432
CATALOG_DB_NAME=schema_catalog
CATALOG_DB_USER=catalog_user
CATALOG_DB_PASSWORD=catalog_pass_change_me
CATALOG_DB_EXTERNAL_PORT=5434

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_EXTERNAL_PORT=8000
LOG_LEVEL=INFO

# --- Frontend ---
FRONTEND_EXTERNAL_PORT=8501
BACKEND_URL=http://backend:8000

# --- Seed ---
SEED_PATIENT_COUNT=200
SEED_RANDOM_SEED=42

# --- Embedding (Step 3, CPU-only) ---
# fake: deterministic vectors for tests/CI (no model download)
# bge_m3: real BAAI/bge-m3 via sentence-transformers (CPU)
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL_NAME=BAAI/bge-m3
# Offline / air-gapped: set local path produced by scripts/download_embedding_model.py
# EMBEDDING_MODEL_PATH=/models/local/bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=8
EMBEDDING_MAX_SEQ_LENGTH=1024
EMBEDDING_NORMALIZE=true
# EMBEDDING_NUM_THREADS=4
# HF_HUB_OFFLINE=true
# EMBEDDING_MODEL_REVISION=default

# --- Search (Step 4) ---
# Fake provider blocks semantic/hybrid unless explicitly allowed (tests only)
ALLOW_FAKE_SEMANTIC_SEARCH=false
SEARCH_RRF_K=60
SEARCH_CANDIDATE_MULTIPLIER=3
SEARCH_CANDIDATE_MIN=20
# MEDICAL_TERMS_PATH=/app/app/resources/medical_terms.json
